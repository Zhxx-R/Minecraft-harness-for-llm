APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://mc_agent:mc_agent@localhost:5432/mc_agent
POSTGRES_PASSWORD=mc_agent
REDIS_URL=redis://localhost:6379/0

MODEL_DEFAULT=qwen3.7-plus
QWEN_API_KEY=replace-me
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

MINEFLAYER_WORKER_URL=ws://localhost:8765
MINECLIP_SCORER_URL=http://127.0.0.1:8091
MINECLIP_VARIANT=attn
MINECLIP_CHECKPOINT=/absolute/path/to/mineclip_attn.pth
MINECLIP_REPOSITORY=services/mineclip-scorer/vendor/MineCLIP
MINECLIP_DEVICE=auto
MINECLIP_SCORER_HOST=127.0.0.1
MINECLIP_SCORER_PORT=8091
ARTIFACT_ROOT=runs
MINECRAFT_HOST=localhost
MINECRAFT_PORT=25565
MINECRAFT_USERNAME=HarnessAgent
MINECRAFT_RCON_HOST=localhost
MINECRAFT_RCON_PORT=25575
MINECRAFT_RCON_PASSWORD=replace-me
MC_AGENT_SPECTATOR_PLAYER=replace-me
MC_AGENT_RECORDING_WINDOW_TITLE=Minecraft
# Optional stricter process constraint for the Java client, usually "java" on macOS.
MC_AGENT_RECORDING_WINDOW_OWNER=
MC_AGENT_SPECTATOR_WAIT_SEC=300
MC_AGENT_SPECTATOR_CHUNK_SYNC_DELAY_SEC=0.75
MC_AGENT_SPECTATOR_REBIND_INTERVAL_SEC=10
MC_AGENT_SPECTATOR_FULL_SYNC_INTERVAL_SEC=0
MC_AGENT_SPECTATOR_RESYNC_DISTANCE_BLOCKS=96
MC_AGENT_SPECTATOR_RESYNC_COOLDOWN_SEC=30
MC_AGENT_STOP_SERVER_AFTER_RUN=1

# Local Minecraft server memory. Two concurrent servers require separate sizing.
MC_SERVER_XMS=1G
MC_SERVER_XMX=2500M
MC_SERVER_POOL_SIZE=2
MC_SERVER_POOL_FIRST_PORT=25565
MC_SERVER_POOL_FIRST_RCON_PORT=25575
