{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-agent-harness.local/schemas/trajectory-event.schema.json",
  "title": "TrajectoryEvent",
  "type": "object",
  "required": ["run_id", "event_type", "timestamp", "payload"],
  "properties": {
    "run_id": { "type": "string" },
    "task_id": { "type": "string" },
    "agent_id": { "type": "string" },
    "event_type": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" }
  }
}

